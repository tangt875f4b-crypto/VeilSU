<?xml version="1.0" encoding="utf-8"?>
<!-- VeilSU v1 icon: a dark veil draped over a shield, forming a V.
     Replaces the upstream mascot vector. Group names are kept so the
     splash animation (ic_launcher_splash) still has targets. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
  <group
      android:name="splash_main_body"
      android:pivotX="256"
      android:pivotY="256">
      <!-- teal shield outline -->
      <path
          android:fillColor="#14B8A6"
          android:pathData="M256,36 L408,96 V296 C408,404 336,462 256,484 C176,462 104,404 104,296 V96 Z" />
      <!-- dark shield -->
      <path
          android:fillColor="#17172B"
          android:pathData="M256,62 L384,114 V294 C384,388 322,438 256,458 C190,438 128,388 128,294 V114 Z" />
      <!-- veil fold: the V -->
      <path
          android:fillColor="#00000000"
          android:strokeColor="#2DD4BF"
          android:strokeWidth="18"
          android:strokeLineCap="round"
          android:strokeLineJoin="round"
          android:pathData="M172,172 L256,322 L340,172" />
      <!-- veil drapes -->
      <path
          android:fillColor="#00000000"
          android:strokeColor="#2DD4BF"
          android:strokeAlpha="0.55"
          android:strokeWidth="12"
          android:strokeLineCap="round"
          android:pathData="M172,172 L146,300" />
      <path
          android:fillColor="#00000000"
          android:strokeColor="#2DD4BF"
          android:strokeAlpha="0.55"
          android:strokeWidth="12"
          android:strokeLineCap="round"
          android:pathData="M340,172 L366,300" />
      <group android:name="splash_accent_heart">
          <path
              android:fillColor="#2DD4BF"
              android:pathData="M256,306 m-16,0 a16,16 0 1,1 32,0 a16,16 0 1,1 -32,0" />
      </group>
  </group>
</vector>

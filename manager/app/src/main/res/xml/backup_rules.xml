<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older that API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="sharedpref" path="theme_device_access.xml"/>
    <!-- Dynamic wallpapers can be up to 308 MB; never push them through backup. -->
    <exclude domain="file" path="backgrounds/dynamic_wallpaper.mp4"/>
    <exclude domain="file" path="backgrounds/dynamic_wallpaper.webp"/>
    <exclude domain="file" path="backgrounds/dynamic_wallpaper.mp4.tmp"/>
    <exclude domain="file" path="backgrounds/dynamic_wallpaper.webp.tmp"/>
    <exclude domain="file" path="backgrounds/dynamic_home_card.mp4"/>
    <exclude domain="file" path="backgrounds/dynamic_home_card.webp"/>
    <exclude domain="file" path="backgrounds/dynamic_home_card.mp4.tmp"/>
    <exclude domain="file" path="backgrounds/dynamic_home_card.webp.tmp"/>
    <exclude domain="file" path="backgrounds/adaptive_draft_dynamic_wallpaper.mp4"/>
    <exclude domain="file" path="backgrounds/adaptive_draft_dynamic_wallpaper.webp"/>
    <exclude domain="file" path="backgrounds/adaptive_draft_dynamic_home_card.mp4"/>
    <exclude domain="file" path="backgrounds/adaptive_draft_dynamic_home_card.webp"/>
    <!-- "My downloads" packages are large and re-downloadable; keep them out of backups. -->
    <exclude domain="file" path="theme_downloads/"/>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
#! /usr/bin/env bash
#
# VeilSU package randomizer (adapted from upstream SukiSU's randomizer).
# Renames the manager package me.veilsu.manager — and the AIDL package
# com.veilsu.zako — to random words, in directory names and file contents.
# Run from the manager/ directory (so build.gradle.kts below is this
# module's build file, as in upstream).

# Generate 3 random lowercase words (6 letters each)
word1=$(tr -dc 'a-z' </dev/urandom | head -c6)
word2=$(tr -dc 'a-z' </dev/urandom | head -c6)
word3=$(tr -dc 'a-z' </dev/urandom | head -c6)
word4=$(tr -dc 'a-z' </dev/urandom | head -c6)


# Export variables for use in find -exec
export word1 word2 word3 word4

# Rename directories
# (segment 1: me/com, segment 2: veilsu, segment 3: manager/zako)
find . -depth -type d -name 'me' -execdir mv {} "$word1" \;
find . -depth -type d -name 'com' -execdir mv {} "$word4" \;
find . -depth -type d -name 'veilsu' -execdir mv {} "$word2" \;
find . -depth -type d -name 'manager' -execdir mv {} "$word3" \;
find . -depth -type d -name 'zako' -execdir mv {} "$word3" \;


# Replace inside files
find . -type f -exec sed -i \
    -e "s/me\.veilsu\.manager/$word1.$word2.$word3/g" \
    -e "s/com\.veilsu\.zako/$word4.$word2.$word3/g" \
    -e "s/me\/veilsu\/manager/$word1\/$word2\/$word3/g" \
    -e "s/com\/veilsu\/zako/$word4\/$word2\/$word3/g" \
    -e "s/me_veilsu_manager/${word1}_${word2}_${word3}/g" \
    -e "s/com_veilsu_zako/${word4}_${word2}_${word3}/g" {} +

# add -spoofed on tags
sed -i -e '/fun getGitDescribe(): String {/,/^    }/ s/\.trim()$/.trim() + "-spoofed"/' build.gradle.kts
